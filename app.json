{
  "expo": {
    "name": "ddairy",
    "slug": "ddairy",
    "description": "A softer place for your days. Dictate diary entries, keep a main diary, and make extra books for everything else.",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ddairy",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#C25E46",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ddairy.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ddairy.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#F5EFE4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "ddairy",
      "shortName": "ddairy",
      "themeColor": "#C25E46",
      "backgroundColor": "#F5EFE4"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5EFE4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#181511",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 180
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "ddairy uses the microphone so you can speak your diary entries instead of typing them.",
          "speechRecognitionPermission": "ddairy turns your spoken words into journal text using your device's speech recognition.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
